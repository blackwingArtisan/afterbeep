# AfterBeep runs with no accounts and no keys. Every variable below is optional.

PORT=3111
AFTERBEEP_PUBLIC_URL=http://localhost:3111
AFTERBEEP_DATA_DIR=data
# Demo mode turns on the call simulator (POST /api/calls) and the reset button, which need no login.
# Leave unset for the default: on while every adapter is local, off as soon as any real adapter is
# selected. Set "off" on any public deploy that holds real data.
# AFTERBEEP_DEMO=on

# Adapters. The first value in each comment is the free local default.
AFTERBEEP_TRANSCRIBER=local   # local | aws (Amazon Transcribe)
AFTERBEEP_EXTRACTOR=rules     # rules | bedrock (Amazon Bedrock Converse, falls back to rules)
AFTERBEEP_SMS=outbox          # outbox | aws (AWS End User Messaging SMS)
AFTERBEEP_INVOICES=local      # local | stripe (Stripe Invoicing, test keys only)

# Real phone path (Amazon Connect -> Lambda -> webhook).
AFTERBEEP_WEBHOOK_SECRET=

# Only needed for the aws adapters. Credentials come from the standard AWS provider chain.
AWS_REGION=us-east-1
AFTERBEEP_BEDROCK_MODEL=amazon.nova-lite-v1:0
AFTERBEEP_SMS_ORIGINATION=

# Only needed for AFTERBEEP_INVOICES=stripe. Must start with sk_test_.
STRIPE_SECRET_KEY=
